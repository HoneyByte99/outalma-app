# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Seed/admin script credentials : never commit
scripts/service-account.json
**/service-account*.json
**/*firebase-adminsdk*.json
secrets/

# Pre-write dumps of production documents, written by the migration scripts
# (fix-service-zone-keys.py --apply). Production data, not source.
scripts/backups/

# Environment / secrets : never commit billing-sensitive keys
.env
.env.*
!.env.example

# iOS secrets : copy Secrets.xcconfig.example → Secrets.xcconfig and fill in values
ios/Flutter/Secrets.xcconfig

# Node.js (root-level package.json for web tooling)
node_modules/

# Firebase config : injected by CI (GitHub Secrets); never commit live credentials.
# Copy the .example versions, fill in real values, and add them as GitHub Secrets.
ios/Runner/GoogleService-Info.plist
android/app/google-services.json
lib/firebase_options.dart

# Seed data : contains test-account credentials and tester PII; never commit.
seed/

# Android release signing : never commit
android/key.properties
*.jks
*.keystore

# Forge cycle state, ephemeral and per-worktree, never committed
.claude/forge/
# Transient command files written by the skill-creator triggering harness
# (<skill>-skill-<uuid>.md). NOT the whole directory: .claude/commands/ holds
# ten real project commands that ARE tracked, and ignoring it would silence
# every future change to them.
.claude/commands/*-skill-*.md

# Production ops scripts, kept out of the repository on purpose.
# ops_seed_and_claims.py grants admin+moderator claims on the named production
# project AT IMPORT, with no __main__ guard and no --apply. It was swept into a
# commit twice by a broad `git add`, hence this entry rather than vigilance.
scripts/ops_seed_and_claims.py
scripts/reseed_clean_mvp.py
scripts/fix_locations_mvp.py
outalma_beta_invite.html
