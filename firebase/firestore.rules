rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isModerator() { return signedIn() && request.auth.token.moderator == true; }
    function isSupport() { return signedIn() && request.auth.token.support == true; }
    function isReadonly() { return isAdmin() || isModerator() || isSupport() || (signedIn() && request.auth.token.readonly == true); }
    function isAdminOrModerator() { return isAdmin() || isModerator(); }
    function isMinSupport() { return isAdminOrModerator() || isSupport(); }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    function bookingRef(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }
    function bookingDoc(bookingId) { return get(bookingRef(bookingId)); }
    function bookingExists(bookingId) { return exists(bookingRef(bookingId)); }
    function bookingData(bookingId) { return bookingDoc(bookingId).data; }

    function isBookingParticipant(bookingId) {
      return signedIn()
        && bookingExists(bookingId)
        && (bookingData(bookingId).customerId == request.auth.uid
            || bookingData(bookingId).providerId == request.auth.uid);
    }

    /// Phone sharing is unlocked when booking status is accepted, in_progress, or done.
    function bookingAccessible(bookingId) {
      return bookingExists(bookingId)
        && bookingData(bookingId).status in ["accepted", "in_progress", "done"];
    }

    // ---------- USERS ----------
    // Any signed-in user may read profiles (needed to display provider names/avatars
    // on service cards, chat tiles, etc.). Writes remain self-only AND must not
    // touch security-sensitive fields (phoneE164, email, id). Those fields are
    // server-managed (Cloud Functions via admin SDK bypass these rules).
    // `createdAt` is intentionally not checked: Dart DateTime↔Timestamp round-trip
    // loses nanosecond precision, so equality always fails even when the value is
    // genuinely unchanged. phoneE164 and email are the real account-takeover guards.
    // This is the primary defence against account-takeover via phone-claim attacks
    // (cf. security review C1 / C2).
    match /users/{uid} {
      // `id` is not stored as a document field (it is the document path), so
      // never include it in field-level checks. `isSelf(uid)` already binds the
      // path wildcard to the authenticated user's uid.
      function isUserUpdateSafe() {
        // Use .get() with a sentinel default for phoneE164 because dot-notation on an
        // absent field does not compare equal to null in Firestore rules, only .get()
        // guarantees a safe fallback that makes null==null evaluate to true.
        return request.resource.data.get('phoneE164', '__absent__') == resource.data.get('phoneE164', '__absent__')
          && request.resource.data.email == resource.data.email;
      }
      // Email-only accounts must not carry a phoneE164 field on create, phone
      // numbers are written exclusively by Cloud Functions (admin SDK, bypasses
      // these rules). The path-level isSelf(uid) guard already ensures the user
      // can only write their own document.
      function isUserCreateSafe() {
        return !('phoneE164' in request.resource.data);
      }

      allow read: if signedIn();
      allow create: if isAdmin() || (isSelf(uid) && isUserCreateSafe());
      allow update: if isAdmin() || (isSelf(uid) && isUserUpdateSafe());
      allow delete: if isAdmin();

      // Users a person has blocked, private to that person.
      match /blockedUsers/{blockedUid} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---------- PROVIDERS (public read, owner write) ----------
    match /providers/{uid} {
      allow read: if true;
      allow create: if isAdmin() || isSelf(uid);
      // Owner may edit their own profile (bio, working hours) AND flip their own
      // availability `active` (Disponible/En pause). But NOT the moderation
      // fields: a suspended provider must not be able to self-write
      // `suspended:false` and undo moderation. Those keys are set exclusively by
      // suspendProvider/unsuspendProvider (Admin SDK) and read back as a gate in
      // createBooking. (Security review S2.) `active` is intentionally NOT in
      // this list, it is the owner-controlled pause switch, also gated server-
      // side in createBooking.
      //
      // The identity badge is deliberately NOT here: budget line S4 forbids
      // guarding a trust field with a deny list, since a deny list only covers
      // the keys someone remembered to list. It lives in `provider_trust`,
      // below, which no client can write at all.
      allow update: if isAdmin()
        || (isSelf(uid)
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['suspended', 'suspendedAt', 'suspendedReason']));
      allow delete: if isAdmin();
    }

    // ---------- BLOCKED SLOTS (provider availability) ----------
    match /providers/{uid}/blocked_slots/{slotId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || isSelf(uid);
      allow delete: if isAdmin() || isSelf(uid);
    }

    // ---------- IDENTITY VERIFICATION (provider CNI + selfie) ----------
    // Every write goes through Cloud Functions (Admin SDK bypasses these rules).
    // Direct client writes are denied everywhere below: a verdict is a trust
    // decision, and the client is never trusted with one.
    //
    // The file is deliberately split in two documents because Firestore rules
    // authorise a WHOLE document, never a field: the provider must be able to
    // read their own status, rejection reason and extracted fields, but must
    // never see the duplicate flag nor `doublonReferenceId`, which is the id of
    // ANOTHER provider's file. Hence a subcollection the owner cannot read.
    match /identity_verifications/{verificationId} {
      allow read: if isAdminOrModerator()
        || (signedIn() && resource.data.providerId == request.auth.uid);
      allow write: if false;

      // Review aids: duplicate flag, reference to a third party's file, storage
      // paths, raw MRZ, reviewer identity. Staff only, never the owner.
      match /identity_internal/{docId} {
        allow read: if isAdminOrModerator();
        allow write: if false;
      }
    }

    // Per-provider guard document. Serialises concurrent submissions and holds
    // the rate-limit window. Nominative, so it is deleted with the account.
    //
    // Read is open to staff only, and NOT to the provider it describes: letting
    // the owner read it would expose nothing they cannot already infer from
    // their own files, but it would put a rate-limit counter in reach of the
    // party the limit constrains. Staff can read it because the review screen
    // will need to explain why a provider cannot submit again.
    match /identity_verification_states/{uid} {
      allow read: if isAdminOrModerator();
      allow write: if false;
    }

    // ---------- PROVIDER TRUST (public projection, server-owned) ----------
    //
    // One document per provider, carrying the public identity state and nothing
    // else: no name, no card number, no storage path, no rejection reason, no
    // file id. The document is world readable, so everything in it is public.
    //
    // Two values only, `pending` and `verified`. Absence is the third state,
    // "not verified": a rejected or revoked file deletes the document, so a
    // refusal is publicly indistinguishable from never having submitted. There
    // is no public shaming in this product.
    //
    // `write: if false` for every client, including the provider it describes
    // and including admin: it is derived from the guard document by the decision
    // transaction (Admin SDK, which bypasses these rules), never typed by hand.
    // That is what budget line S4 asks for, and it is why the flag does not live
    // on `providers/{uid}` behind a deny list.
    match /provider_trust/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- SERVICE TYPES (reference collection) ----------
    match /service_types/{typeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- PRICING CONFIG (public read, no client write) ----------
    // Single source of the pricing grid, read by these rules AND by the app.
    // Writes are closed even to admins: the grid is edited from the Firebase
    // console via the Admin SDK (which bypasses rules), so there is no client
    // write path to secure. Stricter than service_types on purpose. If the
    // document is missing, service writes fail closed (see priceWithinBounds).
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- SERVICES (public read) ----------
    match /services/{serviceId} {
      allow read: if true;

      // Providers are active by default, publishing is NOT gated on onboarding.
      // The only block is moderation: a suspended provider cannot publish. No
      // provider doc yet → allowed (active by default). (E1, relaxed.)
      function publishAllowed() {
        return request.resource.data.published != true
          || !exists(/databases/$(database)/documents/providers/$(request.auth.uid))
          || get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.suspended != true;
      }

      // categoryId must be one of the fixed catalogue categories, no
      // off-catalogue services, regardless of client or direct API write.
      function validCategory() {
        return request.resource.data.categoryId in [
          'menage', 'cuisine', 'plomberie', 'jardinage', 'electricite',
          'peinture', 'bricolage', 'gardeEnfants', 'repassage'
        ];
      }

      // ----- Encadre pricing guard (spec pricing-ranges) -----
      // The grid lives in config/pricing; these rules are its enforcer. The
      // app only mirrors this guard for input comfort, it is never the source.
      function pricingCfg() {
        return get(/databases/$(database)/documents/config/pricing).data;
      }

      // Explicit branches rather than cfg.modes[mode]: indexing a map by a
      // variable key that is absent fails the whole rule evaluation. An unknown
      // mode falls through to monthly here but is then rejected by the
      // priceType allowlist below, so no read error occurs.
      function boundsFor(cfg, mode) {
        return mode == 'hourly' ? cfg.modes.hourly
             : mode == 'daily'  ? cfg.modes.daily
             : cfg.modes.monthly;
      }

      // All arithmetic is integer. Comparing price <= max * (1 + pct/100) in
      // floating point would reject legitimate values (3500 * 1.15 = 4024.99).
      // Written price * 100 <= max * (100 + pct * n), exact for whole percents.
      function priceWithinBounds() {
        let d = request.resource.data;
        let cfg = pricingCfg();
        let extras = d.get('extraTasks', []);
        let distinct = extras.toSet();
        // Count DISTINCT tasks. Using the raw list length here would let a
        // direct write inflate the ceiling with duplicates (e.g. three copies
        // of one task priced at the N=3 cap); the equality below also rejects
        // any list that carries duplicates in the first place.
        let n = distinct.size();
        let b = boundsFor(cfg, d.priceType);
        let cap = b.max * (100 + b.extraBonusPercent * n);
        return d.priceType in ['hourly', 'daily', 'monthly']
          && d.price is int
          && n <= cfg.maxExtraTasks
          && extras.size() == n
          && distinct.hasOnly(cfg.boundedCategories)
          && !(d.categoryId in extras)
          && d.price >= b.min
          && d.price * 100 <= cap
          && (d.priceType == 'monthly'
                ? (d.priceMax is int
                    && d.priceMax >= d.price
                    && d.priceMax * 100 <= cap)
                : !('priceMax' in d));
      }

      // Only the bounded launch categories are constrained; the five off-launch
      // categories keep a free price because they are absent from
      // boundedCategories, not because an if forgot them.
      function priceGuard() {
        return !(request.resource.data.categoryId in pricingCfg().boundedCategories)
          || priceWithinBounds();
      }

      // Create by owner provider
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.providerId == request.auth.uid
            && validCategory()
            && priceGuard()
            && publishAllowed());

      // Update by owner; providerId immutable
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.providerId == request.auth.uid
            && request.resource.data.providerId == resource.data.providerId
            && validCategory()
            && priceGuard()
            && publishAllowed());

      allow delete: if isAdmin()
        || (signedIn() && resource.data.providerId == request.auth.uid);
    }

    // ---------- BOOKINGS (private) ----------
    // Note: isBookingParticipant() is NOT used here, it calls get() on the
    // booking document itself (circular reference), which Firestore denies for
    // both get and list. Use resource.data directly instead.
    match /bookings/{bookingId} {
      function isParticipant() {
        return signedIn()
          && (resource.data.customerId == request.auth.uid
              || resource.data.providerId == request.auth.uid);
      }

      allow get: if isAdminOrModerator() || isParticipant();
      allow list: if isAdminOrModerator() || isParticipant();

      // Create: bookings are created exclusively via the createBooking Cloud Function
      // (Admin SDK bypasses rules). Direct client writes are blocked to prevent
      // status/field bypass attacks.
      allow create: if false;

      // Update: bookings are mutated EXCLUSIVELY by Cloud Functions (accept,
      // reject, cancel, markInProgress, confirmDone, Admin SDK bypasses rules).
      // The client never writes a booking document (the repository only reads),
      // so any client update is denied. This closes the previous hole where a
      // participant could forge server-authoritative fields (chatId, doneAt,
      // cancelledBy, reminded24h/1h…) as long as status + ids were unchanged.
      // (Security review S3.)
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ---------- CHATS (private to participants) ----------
    match /chats/{chatId} {
      function isChatParticipant() {
        return signedIn()
          && (request.auth.uid in resource.data.participantIds);
      }

      allow read: if isAdminOrModerator() || isChatParticipant();

      // Chat documents are created exclusively by the acceptBooking Cloud Function.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        // isChatParticipant() uses resource which refers to the message doc (not the chat).
        // For messages we must get() the parent chat document explicitly.
        function chatData() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function isParticipantViaChat() {
          return signedIn()
            && (request.auth.uid in chatData().participantIds);
        }
        // The participant who is not the sender (2-party chats).
        function otherParticipantUid() {
          return chatData().participantIds[0] == request.auth.uid
            ? chatData().participantIds[1]
            : chatData().participantIds[0];
        }
        // Block enforcement: neither party may message if either has blocked
        // the other. Repeated get()/exists() on the same doc are cached, so this
        // touches at most 3 unique documents.
        function notBlockedPair() {
          return !exists(/databases/$(database)/documents/users/$(otherParticipantUid())/blockedUsers/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(otherParticipantUid()));
        }
        // Conversation locks (read-only) once the related booking is done.
        function bookingActiveForChat() {
          return chatData().bookingId == null
            || chatData().bookingId == ''
            || !exists(/databases/$(database)/documents/bookings/$(chatData().bookingId))
            || get(/databases/$(database)/documents/bookings/$(chatData().bookingId)).data.status != 'done';
        }

        allow read: if isAdminOrModerator() || isParticipantViaChat();

        // Create: only participants; senderId must match auth uid;
        // text OR mediaUrl must be present (supports image/voice messages);
        // blocked pairs cannot message; locked once the booking is done.
        allow create: if isAdmin()
          || (isParticipantViaChat()
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.createdAt is timestamp
              && (request.resource.data.text is string
                  || request.resource.data.mediaUrl is string)
              && notBlockedPair()
              && bookingActiveForChat());

        // Read receipt update: participants may only append their own uid to readBy.
        allow update: if isAdmin()
          || (isParticipantViaChat()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              && request.auth.uid in request.resource.data.readBy)
          // A participant may add/update emoji reactions, but ONLY their own
          // entry in the reactions map (keyed by uid). Previously any
          // participant could overwrite/delete the OTHER party's reaction.
          // (Security review S4.)
          || (isParticipantViaChat()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.reactions.diff(resource.data.get('reactions', {}))
                  .affectedKeys().hasOnly([request.auth.uid]))
          // Sender soft-deletes their own message: only the `deleted` flag may
          // change, and it can only flip to true.
          || (resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
              && request.resource.data.deleted == true)
          // Sender edits their own message text within 15 minutes of sending:
          // only text + edited may change, edited flips to true. Edits are also
          // blocked once the booking is done (conversation read-only) or when
          // the pair is blocked, same gate as create. (Security review S4.)
          || (resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
              && request.resource.data.edited == true
              && request.resource.data.text is string
              && request.time < resource.data.createdAt + duration.value(15, 'm')
              && bookingActiveForChat()
              && notBlockedPair());

        allow delete: if isAdmin();
      }

      // ---------- TYPING INDICATORS ----------
      // Each user writes their own doc (uid == auth.uid).
      // Read is open to any chat participant.
      // Abuse risk: negligible, one tiny doc per participant, no data exposed.
      match /typing/{uid} {
        function isParticipantViaChatForTyping() {
          return signedIn()
            && (request.auth.uid in
                get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
        }

        allow read: if isAdminOrModerator() || isParticipantViaChatForTyping();
        allow write: if isParticipantViaChatForTyping()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isParticipantViaChatForTyping() && request.auth.uid == uid;
      }
    }

    // ---------- PHONE SHARE (unlock after accept or beyond) ----------
    match /bookings/{bookingId}/phoneShares/{uid} {
      allow read: if isAdmin()
        || (isBookingParticipant(bookingId) && bookingAccessible(bookingId));

      allow create: if isAdmin()
        || (isBookingParticipant(bookingId)
            && isSelf(uid)
            && bookingAccessible(bookingId)
            && request.resource.data.phone is string
            && request.resource.data.phone.matches('^\\+[1-9][0-9]{6,14}$')
            && request.resource.data.createdAt is timestamp);

      allow update: if isAdmin()
        || (isBookingParticipant(bookingId)
            && isSelf(uid)
            && bookingAccessible(bookingId)
            && request.resource.data.phone is string
            && request.resource.data.phone.matches('^\\+[1-9][0-9]{6,14}$'));

      allow delete: if isAdmin();
    }

    // ---------- REVIEWS ----------
    // Reviews are only allowed after a booking reaches "done" status.
    // Reviewer must be a participant of the referenced booking.
    match /reviews/{reviewId} {
      allow read: if signedIn();

      // Create-only (no non-admin update) + deterministic doc id
      // "{bookingId}_{reviewerId}" guarantees one review per (booking, reviewer):
      // a second attempt targets an existing doc → update → denied.
      // revieweeId must be the OTHER booking participant (no self-review).
      allow create: if signedIn()
        && reviewId == request.resource.data.bookingId + '_' + request.auth.uid
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.bookingId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && bookingExists(request.resource.data.bookingId)
        && bookingData(request.resource.data.bookingId).status == "done"
        && (
          (bookingData(request.resource.data.bookingId).customerId == request.auth.uid
            && request.resource.data.revieweeId == bookingData(request.resource.data.bookingId).providerId)
          || (bookingData(request.resource.data.bookingId).providerId == request.auth.uid
            && request.resource.data.revieweeId == bookingData(request.resource.data.bookingId).customerId)
        )
        // Coupure totale: no review between a blocked pair (either direction).
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(request.resource.data.revieweeId))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.revieweeId)/blockedUsers/$(request.auth.uid));

      allow update, delete: if isAdmin();
    }

    // ---------- REPORTS (any signed-in user can create, support+ read) ----------
    match /reports/{reportId} {
      allow read: if isMinSupport();
      allow create: if signedIn();
      allow update: if isMinSupport();
      allow delete: if isAdmin();
    }

    // ---------- DATA EXPORT REQUESTS (RGPD portability) ----------
    // Created exclusively by the requestDataExport Cloud Function (Admin SDK).
    // The doc holds the destination email (PII), readable only by the owner
    // and support+, who fulfil it from the admin dashboard.
    match /data_export_requests/{reqId} {
      allow read: if isMinSupport()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ---------- USER ROLES (admin visibility on privileged accounts) ----------
    match /user_roles/{uid} {
      allow read: if isReadonly();
      allow write: if false; // written exclusively by Cloud Functions (Admin SDK)
    }

    // ---------- MODERATION QUEUE (pre-publication review) ----------
    match /moderation_queue/{docId} {
      allow read: if isMinSupport();
      allow write: if false; // written exclusively by Cloud Functions (Admin SDK)
    }

    // ---------- USER BANS (ban/suspend/shadow-ban records) ----------
    match /user_bans/{userId} {
      allow read: if isMinSupport();
      allow write: if false; // written exclusively by Cloud Functions (Admin SDK)
    }

    // ---------- ADMIN LOGS (audit trail, moderator+ read) ----------
    match /admin_logs/{logId} {
      allow read: if isReadonly();
      allow write: if false; // written exclusively by Cloud Functions (Admin SDK)
    }

    // ---------- NOTIFICATIONS (private to owner) ----------
    match /notifications/{uid}/items/{notifId} {
      allow read: if isSelf(uid);

      // Only Cloud Functions (admin SDK) may create notifications.
      allow create: if isAdmin();

      // Owner may only flip the 'read' field.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if isAdmin() || isSelf(uid);
    }

    // ---------- USER SESSIONS (staff read-only, written by Cloud Functions) ----------
    match /user_sessions/{uid} {
      allow read: if isReadonly();
      allow write: if false; // written exclusively by Cloud Functions (Admin SDK)

      match /events/{eventId} {
        allow read: if isReadonly();
        allow write: if false;
      }
    }

    // Collection group rule required for collectionGroup('events') queries.
    // Without this, Firestore rejects the query even if the nested rule exists.
    match /{path=**}/events/{eventId} {
      allow read: if isReadonly();
      allow write: if false;
    }

    // ---------- PLATFORM STATS (staff read-only, CF write-only) ----------
    match /platform_stats/{docId} {
      allow read: if isReadonly();
      allow write: if false; // written exclusively by Cloud Functions (Admin SDK)
    }

    // ---------- IP GEO CACHE (admin read-only, CF write-only) ----------
    match /ip_geo_cache/{hash} {
      allow read: if isAdmin();
      allow write: if false; // written exclusively by Cloud Functions (Admin SDK)
    }

    // ---------- STATS (analytics counters, admin read-only, CF write-only) ----------
    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- SECURITY ALERTS (admin read, CF write-only) ----------
    match /security_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false; // written exclusively by Cloud Functions (Admin SDK)
    }

    // ---------- IP BLOCKLIST (admin read, CF write-only) ----------
    match /ip_blocklist/{entryId} {
      allow read: if isAdmin();
      allow write: if false; // written exclusively by Cloud Functions (Admin SDK)
    }

    // ---------- PROCESSED EVENTS (trigger dedup, CF only via Admin SDK) ----------
    // Used by stat-increment triggers to prevent double-counting on Firebase retries.
    // Should be purged after 7 days via a Firestore TTL policy on the `processedAt` field.
    match /processed_events/{eventId} {
      allow read, write: if false; // CF only via Admin SDK
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
